~ start
$> GlobalVars.tic_visited = true
Tic: 'morning
- Good morning
- You seem troubled
	Tic: I'm not
	- Okay, have a nice day then
		=> END
	- You're sure?
		Tic: YES, I'M SURE
		- Okay, okay....
			=> END
	- If you want to talk, I'm here
		=> quest_start
Tic: ...
- If there's anything you want to talk about, I'm here
	=> quest_start
- Have a nice day 
=> END

